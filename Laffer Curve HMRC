# ---- CELL 7: Sensitivity table across the literature's elasticity range ---
e_values = [0.12, 0.20, 0.31, 0.40, 0.48, 0.60, 0.83]
sensitivity = pd.DataFrame({
    "elasticity_e": e_values,
    "optimal_top_rate": [f"{optimal_top_rate(a_param, e):.1%}" for e in e_values],
})
print(f"Sensitivity of τ* to elasticity (a = {a_param:.2f}, from HMRC {TAX_YEAR} Top 1% band):\n")
print(sensitivity.to_string(index=False))
